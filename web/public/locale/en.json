        "claudeCLIAutoCompact": {
            "label": "Claude CLI auto compact",
            "hint": "Off by default; passes through Claude CLI native behavior. When on, adds context_management clear_thinking only if the client did not send it, reducing slow long chats and CLI hangs."
        },
        "claudeCLIReasoningEffort": {
            "label": "Claude reasoning effort",
            "hint": "Default \"Adaptive\": follows the client request — high stays high, low stays low, and if none is sent the model decides on its own; Octopus does not override. Low/Medium/High force that level when the client sent none; Off adds no effort at all.",
            "auto": "Adaptive (follow request)",
            "off": "Off",
            "low": "Low",
            "medium": "Medium",
            "high": "High"
        },
        "codexFastMode": {
            "label": "Codex fast mode",
            "hint": "Off by default; follows the client request. When on, adds text.verbosity=low and reasoning_effort=low only if the client omitted them — faster output but terser answers."
        },
        "streamKeepalive": {
            "label": "Stream keepalive interval",
            "hint": "Sends a keepalive only during an active streaming request when no output has been written for the configured number of seconds. It does not start another upstream request or consume extra tokens.",
            "description": "Helps long Claude/MCP tool calls survive reverse proxies and clients that close apparently idle streams.",
            "disabledHint": "0 seconds disables",
            "envHint": "can still provide the first deployment default.",
            "placeholder": "15",
            "seconds": "sec",
            "invalid": "Keepalive interval must be 0 or a positive integer number of seconds"
        },
        "streamDataTimeout": {
            "label": "Upstream stream idle timeout",
            "hint": "Stops an active streaming request when the upstream provider sends no SSE event for the configured number of seconds. Upstream ping events count as activity.",
            "description": "Prevents a stalled upstream stream from being kept alive forever by downstream keepalive writes.",
            "disabledHint": "0 seconds disables",
            "envHint": "can still provide the first deployment default.",
            "placeholder": "900",
            "seconds": "sec",
            "invalid": "Stream idle timeout must be 0 or a positive integer number of seconds"
        },
        "responsesSessionTTL": {
            "label": "Responses session keep",
            "hint": "Remembers which channel and key own a previous_response_id, reducing broken continuations after restarts or route changes.",
            "description": "Only affects OpenAI Responses continuation routing memory. It does not change normal logs or billing.",
            "defaultHint": "Default 3600 sec",
            "placeholder": "3600",
            "seconds": "sec",
            "invalid": "Responses session keep time must be 0 or a positive integer number of seconds"
        },
